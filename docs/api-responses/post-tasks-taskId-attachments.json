{
  "contractType": "illustrative-response-contract",
  "source": {
    "openapi": "http://localhost:3000/api/docs-json",
    "implementation": "controllers and services in src/modules",
    "note": "Examples use synthetic IDs, emails, timestamps, JWTs and Azure URLs. They are not live production responses."
  },
  "operationId": "AttachmentsController_upload",
  "tag": "Task Attachments",
  "summary": "Upload a file attachment to a task",
  "request": {
    "method": "POST",
    "path": "/tasks/{taskId}/attachments",
    "authentication": {
      "type": "bearer",
      "header": "Authorization",
      "value": "Bearer <jwt_access_token>"
    },
    "parameters": [
      {
        "name": "taskId",
        "in": "path",
        "required": true,
        "example": 1
      }
    ],
    "body": {
      "contentType": "multipart/form-data",
      "body": {
        "file": "<binary_file>"
      }
    }
  },
  "responses": [
    {
      "status": 201,
      "description": "Attachment uploaded successfully",
      "body": {
        "id": 701,
        "fileName": "design.pdf",
        "fileUrl": "https://<storage-account>.blob.core.windows.net/files/<blob-name>"
      }
    },
    {
      "status": 400,
      "description": "Invalid file or task deleted",
      "body": {
        "statusCode": 400,
        "message": "Invalid file or task deleted",
        "error": "Bad Request"
      },
      "note": "Illustrative NestJS exception body. The exact message varies by validation or business-rule failure."
    },
    {
      "status": 401,
      "description": "Unauthorized",
      "body": {
        "statusCode": 401,
        "message": "Unauthorized",
        "error": "Unauthorized"
      },
      "note": "Illustrative NestJS exception body. The exact message varies by validation or business-rule failure."
    },
    {
      "status": 403,
      "description": "Forbidden - not a project member",
      "body": {
        "statusCode": 403,
        "message": "Forbidden - not a project member",
        "error": "Forbidden"
      },
      "note": "Illustrative NestJS exception body. The exact message varies by validation or business-rule failure."
    },
    {
      "status": 404,
      "description": "Task not found",
      "body": {
        "statusCode": 404,
        "message": "Task not found",
        "error": "Not Found"
      },
      "note": "Illustrative NestJS exception body. The exact message varies by validation or business-rule failure."
    }
  ]
}
