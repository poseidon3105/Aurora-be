  "operationId": "AuthController_resetPassword",
  "tag": "Authentication",
  "summary": "Reset password after OTP verification",
  "request": {
    "method": "POST",
    "path": "/auth/reset-password",
    "authentication": {
      "type": "none"
    },
    "parameters": [],
    "body": {
      "contentType": "application/json",
      "body": {
        "email": "user@example.com",
        "newPassword": "NewAbc@1234"
      }
    }
  },
  "responses": [
    {
      "status": 200,
      "description": "Password reset successfully",
      "body": {
        "message": "Password reset successfully. Please log in with your new password."
      }
    },
    {
      "status": 400,
      "description": "OTP not verified or invalid",
      "body": {
        "statusCode": 400,
        "message": "OTP not verified or invalid",
        "error": "Bad Request"
      },
      "note": "Illustrative NestJS exception body. The exact message varies by validation or business-rule failure."
    }
  ]
